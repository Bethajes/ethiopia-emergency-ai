# --- Database (PostgreSQL + PostGIS) -----------------------------------------
# Used by the backend (and by Alembic migrations).
# Local Docker Compose value:
#   DATABASE_URL=postgresql+psycopg://nileshield:nileshield@db:5432/nileshield
# Local host value (connect through the published port):
#   DATABASE_URL=postgresql+psycopg://nileshield:nileshield@localhost:5435/nileshield
DATABASE_URL=

POSTGRES_DB=nileshield
POSTGRES_USER=nileshield
# Change this for any shared or deployed environment.
POSTGRES_PASSWORD=
# Host port for the database (5432 is often already taken locally).
POSTGRES_PORT=5435

# --- API ----------------------------------------------------------------------
# Public URL of the FastAPI backend.
API_BASE_URL=http://localhost:8001
# Port the API is published on inside the container network (fixed: 8001).
BACKEND_PORT=8001
# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# --- Frontend -----------------------------------------------------------------
FRONTEND_PORT=5173
# Optional: absolute API URL for the browser. Leave empty to use the dev proxy.
VITE_API_BASE_URL=

# --- Runtime ------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false